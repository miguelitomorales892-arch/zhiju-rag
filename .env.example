# 知据全项目配置样例：复制为 app/.env 后填写，真实 .env 不提交。
# 已接入：后端 APP_ENV/API_HOST/API_PORT；前端开发代理读取 API_HOST/API_PORT 及 FRONTEND_*。
# 其余键仍为后续功能契约；数据库、模型与 Compose 尚未接入。
# 本文件按 Windows 本地 API + Linux 配套服务规划；启用对应功能前校验必填项。
# 运行时显式指定本文件；进程环境变量优先，不能依赖工作目录自动搜索。

# 全项目基础配置。相对数据路径必须由实现按 app/ 根目录解析。
APP_ENV=development
DATA_ROOT=../.local/development
LOG_LEVEL=INFO

# 本地开发入口。前端只使用公开的 API 路径和开发端口，不读取下方密钥。
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173
FRONTEND_API_BASE_PATH=/api

# PostgreSQL：宿主使用映射端口；容器运行时将 HOST 显式覆盖为 postgres。
# 密码留空，用户在启用数据库前填写；禁止把空值作为可用默认密码。
# 连接 URL 由实现根据分项构建并正确转义密码，不在这里重复维护 URL。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=zhiju_development
POSTGRES_USER=zhiju
POSTGRES_PASSWORD=

# Redis：Celery broker；容器内 HOST 覆盖为 redis。
# 当前规划为默认用户的密码认证，服务启动配置必须与客户端一致。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Qdrant：容器内 URL 覆盖为 http://qdrant:6333。
# API key 在服务端与客户端同时配置；索引名/模型维度由索引实现管理。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# 回答模型。服务商、模型 ID 和资料外发范围确定后填写，不假设供应商。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Embedding 单独配置，不自动继承 LLM 地址或凭据。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_TIMEOUT_SECONDS=60

# 重排需在开发集确定是否启用；关闭时不要求填写服务配置。
RERANK_ENABLED=false
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT_SECONDS=30

# OCR 到扫描件阶段启用；模型资源清单及固定修订随文档 worker 实现确定。
OCR_ENABLED=false

# 原件、数据库/索引、缓存、日志及评测输出在 DATA_ROOT 下按用途分目录。
# Linux worker 的 DATA_ROOT 由部署配置覆盖为容器挂载根；不传入宿主相对路径。
# 镜像版本唯一来源为 deploy/images.env，不在本文件重复声明。
# 测试必须使用独立 DATA_ROOT、数据库、Redis 实例/命名空间和 Qdrant 资源。
# 生产凭据由部署环境注入，不复用本开发配置。
