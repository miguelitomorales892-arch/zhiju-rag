{
  "name": "zhiju-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vue frontend for ZhiJu RAG",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "11.25.0"
